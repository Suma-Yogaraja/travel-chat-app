# Copy this file to .env.local and fill in your values

# Claude API key — get from https://console.anthropic.com (required — model is claude-haiku-4-5-20251001)
ANTHROPIC_API_KEY=

# Neon Postgres connection string — get from https://neon.tech (free tier)
DATABASE_URL=

# NextAuth secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3002

# GitHub OAuth app — create at https://github.com/settings/developers
# Callback URL: http://localhost:3002/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# Google OAuth app — create at https://console.cloud.google.com
# Authorized origin: http://localhost:3002
# Callback URL: http://localhost:3002/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail — for booking confirmations, OTP emails, password resets
# Use an App Password (not your account password): myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Langfuse — LLM observability (traces, token costs, tool calls)
# Create a project at https://cloud.langfuse.com (free tier available)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
# US region: https://us.cloud.langfuse.com — EU region: https://cloud.langfuse.com
LANGFUSE_BASEURL=
# Tags traces so you can filter dev vs prod in the Langfuse dashboard
LANGFUSE_TRACING_ENVIRONMENT=development

# Stripe — payment processing (required for booking)
# Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Run: stripe listen --forward-to localhost:3002/api/stripe/webhook → copy the printed whsec_ key
STRIPE_WEBHOOK_SECRET=

# Flight data source: mock (default) or duffel
FLIGHT_PROVIDER=mock

# Duffel — real flight data (only needed when FLIGHT_PROVIDER=duffel)
# Free sandbox account: https://duffel.com → Developers → API tokens
# Use a test token (starts with duffel_test_...)
DUFFEL_API_KEY=
